<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The connection service keeps SSH sessions alive while other apps browse. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+ asks before the ongoing connections notification can be shown. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_share"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SshfsAndroid">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported: only this app's UI and its own notification action start it. -->
        <service
            android:name=".net.ConnectionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            The SAF seam: each connected host appears as a root in the file picker.
            Exported so other apps' pickers can reach it; MANAGE_DOCUMENTS is a
            signature permission, so only the system may bind it directly.
        -->
        <provider
            android:name=".provider.SshfsDocumentsProvider"
            android:authorities="com.bam.sshfs.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

    </application>

</manifest>
